# Dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/

# Production build and TypeScript/Vite caches
/dist/
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# Local application data (created automatically on first launch)
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Environment variables and local overrides
.env
.env.*
!.env.example

# Logs, test coverage and diagnostic reports
logs/
*.log
coverage/
.nyc_output/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Package archives
*.tgz

# Editor and operating system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
